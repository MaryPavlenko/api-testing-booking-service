    {
      "name": "GET Booking - Get by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains booking structure\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"firstname\");",
              "    pm.expect(res).to.have.property(\"lastname\");",
              "    pm.expect(res).to.have.property(\"totalprice\");",
              "    pm.expect(res).to.have.property(\"depositpaid\");",
              "    pm.expect(res).to.have.property(\"bookingdates\");",
              "    pm.expect(res.bookingdates).to.have.property(\"checkin\");",
              "    pm.expect(res.bookingdates).to.have.property(\"checkout\");",
              "});",
              "",
              "pm.test(\"Returned booking matches created booking\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.firstname).to.eql(\"Mary\");",
              "    pm.expect(res.lastname).to.eql(\"Tester\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
