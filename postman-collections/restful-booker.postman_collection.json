    {
      "name": "PUT Booking - Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Booking is fully updated\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.firstname).to.eql(\"Mary\");",
              "    pm.expect(res.lastname).to.eql(\"Updated\");",
              "    pm.expect(res.totalprice).to.eql(200);",
              "    pm.expect(res.depositpaid).to.eql(false);",
              "    pm.expect(res.bookingdates.checkin).to.eql(\"2025-08-01\");",
              "    pm.expect(res.bookingdates.checkout).to.eql(\"2025-08-10\");",
              "    pm.expect(res.additionalneeds).to.eql(\"Dinner\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
