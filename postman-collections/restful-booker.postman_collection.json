    {
      "name": "POST Booking - Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains bookingid\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"bookingid\");",
              "    pm.expect(res.bookingid).to.be.a(\"number\");",
              "    pm.environment.set(\"bookingid\", res.bookingid);",
              "});",
              "",
              "pm.test(\"Created booking echoes sent data\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.booking.firstname).to.eql(\"Mary\");",
              "    pm.expect(res.booking.lastname).to.eql(\"Tester\");",
              "    pm.expect(res.booking.totalprice).to.eql(219);",
              "    pm.expect(res.booking.depositpaid).to.eql(true);",
              "    pm.expect(res.booking.bookingdates.checkin).to.eql(\"2025-06-01\");",
              "    pm.expect(res.booking.bookingdates.checkout).to.eql(\"2025-06-10\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Mary\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 219,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2025-06-01\",\n    \"checkout\": \"2025-06-10\"\n  },\n  \"additionalneeds\": \"Lunch\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
