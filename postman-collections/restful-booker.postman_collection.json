              "pm.test(\"Status code is 200 for current API behaviour\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains Bad credentials reason\", function () {",
              "    const response = pm.response.json();",
